@page "/service-purchase"
@inject AuthState Auth
@inject NavigationManager Nav
@inject HttpClient Http
@using BlazorClient.Services;
@using Models;

@if (!Auth.IsLoggedIn || Auth.User?.UserType != "member")
{
    <p>Access denied. Members only.</p>
}
else if (purchases is null)
{
    <p>Loading service purchases...</p>
}
else if (!purchases.Any())
{
    <p>No purchases available.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>User</th>
                <th>Service</th>
                <th>Token Cost</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in purchases)
            {
                <tr>
                    <td>@p.User</td>
                    <td>@p.Service</td>
                    <td>@p.TemporalTokenCost</td>
                    <td>@p.Status</td>
                    <td>
                        @if (p.Status != "approved")
                        {
                            <button @onclick="() => ApprovePurchase(p.Id)">Approve</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Models.ServicePurchaseModel>? purchases;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.User?.UserType == "member")
        {
            await GetPurchases();
        }
        else
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task ApprovePurchase(int id)
    {
        var request = new HttpRequestMessage(HttpMethod.Put, $"api/servicePurchase/{id}")
        {
            Content = JsonContent.Create(new { status = "approved" })
        };

        if (!string.IsNullOrEmpty(Auth.Jwt))
        {
            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Auth.Jwt);
        }

        var response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode)
        {
            await GetPurchases();
        }
        else
        {
            Console.WriteLine($"Error updating purchase: {response.StatusCode}");
        }

    }

    private async Task GetPurchases()
    {
        var request = new HttpRequestMessage(HttpMethod.Get, "api/servicePurchase");

        // Add JWT if present
        if (!string.IsNullOrEmpty(Auth.Jwt))
        {
            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Auth.Jwt);
        }

        var response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode)
        {
            purchases = await response.Content.ReadFromJsonAsync<List<ServicePurchaseModel>>() ?? new();
        }
        else
        {
            // handle error
            Console.WriteLine($"Error fetching purchases: {response.StatusCode}");
        }
    }
}
