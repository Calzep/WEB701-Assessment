@page "/services"
@inject HttpClient Http
@inject IJSRuntime JS
@using Models;
@using BlazorClient.Services;

<h3>Services</h3>

@if (services is null)
{
    <p>Loading services...</p>
}
else if (!services.Any())
{
    <p>No services available at this time.</p>
}
else
{
    @foreach (var service in services)
    {
        <div>
            <h3>@service.Name</h3>
            <p>@service.Description</p>
            <p>Token cost: @service.TokenCost</p>
            @if (Auth.IsLoggedIn && Auth.User?.UserType == "beneficiary")
            {
                <button @onclick="() => Purchase(service.Id)">Purchase</button>
            }
        </div>
    }
}

@code {
    [Inject] public AuthState Auth { get; set; } = default!;
    private List<ServiceModel>? services;

    protected override async Task OnInitializedAsync()
    {
        var response = await Http.GetAsync("api/service");
        var raw = await response.Content.ReadAsStringAsync();
        Console.WriteLine(raw);

        if (response.IsSuccessStatusCode)
        {
            services = System.Text.Json.JsonSerializer.Deserialize<List<ServiceModel>>(raw);
        }
        else
        {
            Console.WriteLine($"API returned {response.StatusCode}");
        }

    }

    private async Task Purchase(int serviceId)
    {
        var purchaseRequest = new { serviceId, userId = Auth.User?.Id };
        var request = new HttpRequestMessage(HttpMethod.Post, $"api/servicePurchase/")
        {
            Content = JsonContent.Create(new ServicePurchaseDTO{ Id = serviceId })
        };

        if (!string.IsNullOrEmpty(Auth.Jwt))
        {
            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Auth.Jwt);
        }

        var response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode)
        {
            await JS.InvokeVoidAsync("alert", "Service purchased!");
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Purchase failed");
            Console.WriteLine($"Error creating purchase: {response}");
        }
    }
}
