@page "/register"
@inject HttpClient Http
@inject NavigationManager Nav
@using Models;

<h3>Register</h3>

@if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
}
<input @bind="email" placeholder="Email" />
<br />
<br />
<input @bind="password" type="password" placeholder="Password" />
<br />
<br />
<input @bind="firstName" placeholder="First Name" />
<br />
<br />
<input @bind="lastName" placeholder="Last Name" />
<br />
<br />
<label>User Type:</label>
<select @bind="userType">
    <option value="beneficiary">Beneficiary</option>
    <option value="member">Member</option>
</select>
<br />
<br />
<button @onclick="RegisterUser">Register</button>

@code {
    private string firstName = "";
    private string lastName = "";
    private string email = "";
    private string password = "";
    private string userType = "beneficary";
    private string? message;

    private async Task RegisterUser()
    {
        var response = await Http.PostAsJsonAsync("api/user/register", new UserModel
        {
            Email = email,
            FirstName = firstName,
            LastName = lastName,
            Password = password,
            UserType = userType,
        });

        if (response.IsSuccessStatusCode)
        {
            message = "Account created successfully!";
        }
        else
        {
            message = response.ToString();
        }
    }
}
